# Server & App Configuration
APP_PORT=3000
PORT=3000

# PostgreSQL Database Configuration (Local / Docker)
# Compose uses DB_PASSWORD for PostgreSQL and the backend.
# For an existing PostgreSQL volume, this must match the database user's password.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auto_masters
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=auto_masters

# JWT Authentication
JWT_SECRET=super-secret-jwt-key
JWT_ACCESS_EXPIRE=60
JWT_REFRESH_EXPIRE=720

# MinIO / S3 Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Public URLs & Media
PUBLIC_URL=http://localhost:3000
PUBLIC_MEDIA_URL=http://localhost:9000/autogis-media-dev
STORIES_LOG_PATH=./stories.json

# Maps & External APIs
# Add a Yandex Maps API key restricted to the production site domain.
VITE_YMAPS_API_KEY=f88c5514-7eee-465a-84a2-87f728453219