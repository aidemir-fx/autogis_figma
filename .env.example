# Public address of the application. For local access leave http://localhost.
# On a server use the domain or IP users will open in the browser.
PUBLIC_URL=http://localhost
APP_PORT=80
PUBLIC_MEDIA_URL=http://localhost:9000
STORIES_LOG_PATH=runtime-logs/stories.log
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Required secrets. Change every value before a real deployment.
POSTGRES_PASSWORD=change-this-postgres-password
MINIO_ROOT_USER=autogis-minio
MINIO_ROOT_PASSWORD=change-this-minio-password
JWT_SECRET=change-this-to-a-long-random-secret

# Token lifetime.
JWT_ACCESS_EXPIRE=15
JWT_REFRESH_EXPIRE=24

# Public Yandex Maps key. It is embedded into the frontend during Docker build.
# Restrict it to the production website in Yandex Console; do not put secrets here.
VITE_YMAPS_API_KEY=
